---
import ArrowGo from "../../assets/icons/ui/arrowGo.svg";

import { SKILLS_DATA } from "../../data";
import { getT } from "../../i18n";

interface Props {
  id: string;
  title: string;
  description: string;
  titleKey?: string;
  descKey?: string;
  image: string;
  tags: string[];
}

const { id, title, description, titleKey, descKey, image, tags } = Astro.props;

const t = getT();

const allSkills = Object.values(SKILLS_DATA).flat();

const projectIcons = tags.map((tagId) => {
  const skill = allSkills.find((item) => item.id === tagId);
  return { id: tagId, icon: skill?.icon, name: skill?.name };
});
---

<article
  class="flex flex-col md:flex-row items-stretch justify-between p-6 rounded-2xl border border-brand-muted/20 bg-brand-surface hover:border-brand-accent/40 transition-all duration-300 shadow-sm gap-6 w-full max-w-2xl font-mono group"
>
  <div class="flex-1 flex flex-col justify-between gap-4">
    <div class="flex flex-col gap-2">
      <h3
        data-i18n={titleKey}
        class="text-xl md:text-2xl font-bold text-brand-text tracking-tight group-hover:text-brand-accent transition-colors"
      >
        {title}
      </h3>

      <p
        data-i18n={descKey}
        class="text-xs sm:text-sm text-brand-muted leading-relaxed line-clamp-3"
      >
        {description}
      </p>
    </div>

    <div>
      <button
        type="button"
        data-project-open={id}
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-brand-muted/10 hover:bg-brand-accent hover:text-brand-bg text-brand-text font-semibold text-xs transition-all cursor-pointer border border-brand-muted/20 hover:border-transparent group/btn"
      >
        <span data-i18n="project.card.details"
          >{t("project.card.details", "Ver detalles")}</span
        >
        <ArrowGo />
      </button>
    </div>
  </div>

  <div class="flex flex-col gap-3 w-full md:w-48 shrink-0">
    <div
      class="w-full aspect-4/3 rounded-xl overflow-hidden border border-brand-muted/15 bg-brand-muted/10"
    >
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </div>

    <div class="flex flex-col gap-1.5">
      <span
        data-i18n="project.card.stack"
        class="text-[10px] uppercase font-semibold tracking-wider text-brand-muted"
      >
        {t("project.card.stack", "Stack")}
      </span>

      <div class="flex items-center gap-1.5 flex-wrap">
        {
          projectIcons.map(
            (item) =>
              item.icon && (
                <div
                  title={item.name}
                  class="w-7 h-7 rounded-full bg-[#F5F2EB] dark:bg-[#2A2725] flex items-center justify-center border border-brand-muted/20 shadow-2xs shrink-0"
                >
                  <item.icon class="w-3.5 h-3.5 text-brand-text" />
                </div>
              ),
          )
        }
      </div>
    </div>
  </div>
</article>
