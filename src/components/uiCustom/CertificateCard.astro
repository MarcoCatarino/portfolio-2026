---
interface Props {
  id: string;
  image: string;
  title: string;
}

const { id, image, title } = Astro.props;
---

<button
  type="button"
  data-cert-id={id}
  class="cert-card-btn group relative aspect-6/4 w-full rounded-xl overflow-hidden border border-brand-muted/20 bg-brand-surface hover:border-brand-accent/60 transition-all duration-300 shadow-sm hover:shadow-md cursor-pointer text-left focus:outline-none"
>
  <img
    src={image}
    alt={title}
    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
  />
</button>
