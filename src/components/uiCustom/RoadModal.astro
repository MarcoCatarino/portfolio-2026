---
import Modal from "../ui/Modal.astro";
import { translations, defaultLang } from "../../i18n";

const trans = translations[defaultLang];
---

<Modal id="road-modal">
  <div slot="header" class="flex flex-col gap-1 w-full text-left font-mono">
    <h3
      id="road-modal-title"
      class="text-xl sm:text-2xl font-extrabold text-brand-text tracking-tight"
    >
    </h3>

    <span id="road-modal-org" class="text-xs font-semibold text-brand-accent"
    ></span>
  </div>

  <div slot="content" class="flex flex-col gap-5 text-left font-mono">
    <div class="flex flex-col gap-1.5">
      <h4
        data-i18n="road.modal.description"
        class="text-xs uppercase font-semibold tracking-wider text-brand-muted"
      >
        {trans["road.modal.description"]}
      </h4>
      <p
        id="road-modal-desc"
        class="text-xs sm:text-sm text-brand-muted leading-relaxed"
      >
      </p>
    </div>

    <div class="flex flex-col gap-2 border-t border-brand-muted/15 pt-4">
      <h4
        data-i18n="road.modal.skills"
        class="text-xs uppercase font-semibold tracking-wider text-brand-muted"
      >
        {trans["road.modal.skills"]}
      </h4>
      <ul
        id="road-modal-skills"
        class="list-disc list-inside text-xs sm:text-sm text-brand-text flex flex-col gap-1"
      >
      </ul>
    </div>
  </div>
</Modal>

<script>
  import { translations, defaultLang } from "../../i18n";

  type Lang = keyof typeof translations;

  const getLang = (): Lang => {
    const stored = localStorage.getItem("preferred_lang");
    return stored && stored in translations ? (stored as Lang) : defaultLang;
  };

  const buttons =
    document.querySelectorAll<HTMLButtonElement>(".road-node-btn");
  const modal = document.getElementById("road-modal") as HTMLDialogElement;

  const modalTitle = document.getElementById(
    "road-modal-title",
  ) as HTMLHeadingElement;
  const modalOrg = document.getElementById("road-modal-org") as HTMLSpanElement;
  const modalDesc = document.getElementById(
    "road-modal-desc",
  ) as HTMLParagraphElement;
  const modalSkills = document.getElementById(
    "road-modal-skills",
  ) as HTMLUListElement;

  let activeBtn: HTMLButtonElement | null = null;

  const setButtonState = (btn: HTMLButtonElement, isActive: boolean) => {
    btn
      .querySelector(".level-icon-default")
      ?.classList.toggle("hidden", isActive);
    btn
      .querySelector(".level-icon-active")
      ?.classList.toggle("hidden", !isActive);
  };

  const fillModal = (id: string) => {
    const t = translations[getLang()] as Record<string, unknown>;

    modalTitle.textContent = (t[`road.${id}.title`] as string) ?? "";
    modalOrg.textContent = (t[`road.${id}.organization`] as string) ?? "";
    modalDesc.textContent = (t[`road.${id}.desc`] as string) ?? "";

    const skills = (t[`road.${id}.skills`] as readonly string[]) ?? [];
    modalSkills.replaceChildren(
      ...skills.map((skill) => {
        const li = document.createElement("li");
        li.textContent = skill;
        return li;
      }),
    );
  };

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      if (activeBtn) setButtonState(activeBtn, false);
      activeBtn = btn;
      setButtonState(btn, true);

      fillModal(btn.dataset.roadId ?? "");
      modal?.showModal();
    });
  });

  modal?.addEventListener("close", () => {
    if (activeBtn) {
      setButtonState(activeBtn, false);
      activeBtn = null;
    }
    (document.activeElement as HTMLElement | null)?.blur();
  });
</script>
