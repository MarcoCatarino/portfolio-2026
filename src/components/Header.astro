---
import SunIcon from "../assets/icons/ui/sun.svg";
import MoonIcon from "../assets/icons/ui/moon.svg";
import { translations, defaultLang } from "../i18n";

const lang = defaultLang;

const NavLinks = [
  { id: "about-me", href: "#about-me", key: "nav.about" },
  { id: "projects", href: "#projects", key: "nav.projects" },
  { id: "skills", href: "#skills", key: "nav.skills" },
  { id: "road", href: "#road", key: "nav.road" },
  { id: "certificates", href: "#certificates", key: "nav.certificates" },
  { id: "contact-me", href: "#contact-me", key: "nav.contact" },
];
---

<header
  class="sticky top-0 z-50 w-full backdrop-blur-xs bg-brand-bg/80 border-b border-brand-muted/15 transition-colors duration-300"
>
  <div
    class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between bg-amber-400/30"
  >
    <!-- Logo -->
    <a
      class="font-mono text-sm font-bold tracking-tight text-brand-text hover:text-brand-accent transition-colors"
      href="#top"
    >
      Marco<span class="text-brand-accent">.dev</span>
    </a>

    <!-- NavItems-->
    <nav
      class="hidden md:flex items-center gap-6 font-mono text-sm text-brand-muted"
    >
      {
        NavLinks.map((link) => (
          <a
            href={link.href}
            data-i18n={link.key}
            class="hover:text-brand-text transition-colors py-1 relative"
          >
            {
              translations[lang][
                link.key as keyof (typeof translations)[typeof lang]
              ]
            }
          </a>
        ))
      }
    </nav>

    <!-- NavActions ~ ThemeToggle & TranslateToggle -->
    <div class="flex items-center gap-3 font-mono text-xs">
      <button
        id="langToggle"
        type="button"
        aria-label="Cambiar Idioma"
        class="px-2.5 py-1.5 rounded-md border border-brand-muted/20 hover:border-brand-accent text-brand-text hover:text-brand-accent cursor-pointer"
      >
        <span id="langLabel" class="font-semibold">ES</span>
      </button>

      <button
        id="themeToggle"
        type="button"
        aria-label="Cambiar tema"
        class="p-2 rounded-md border border-brand-muted/20 hover:border-brand-accent text-brand-text hover:text-brand-accent transition-all cursor-pointer flex items-center justify-center"
      >
        <SunIcon class="w-4 h-4 hidden dark:block" />
        <MoonIcon class="w-4 h-4 block dark:hidden" />
      </button>
    </div>
  </div>
</header>

<script>
  import { translations } from "../i18n";

  // Theme Toggle
  const themeBtn = document.getElementById("themeToggle");
  themeBtn?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });

  // Translate Toggle
  const langBtn = document.getElementById("langToggle");
  const langLabel = document.getElementById("langLabel");

  function updateLanguage(lang: "es" | "en") {
    document.querySelectorAll("[data-i18n]").forEach((element) => {
      const key = element.getAttribute("data-i18n") as
        keyof (typeof translations)["es"] | null;
      if (!key) return;

      const value: unknown = translations[lang][key];
      if (typeof value === "string") {
        element.textContent = value;
      }
    });

    if (langLabel) langLabel.textContent = lang.toUpperCase();
    document.documentElement.lang = lang;
    localStorage.setItem("preferred_lang", lang);
  }

  const savedLang =
    (localStorage.getItem("preferred_lang") as "es" | "en") || "es";
  updateLanguage(savedLang);

  langBtn?.addEventListener("click", () => {
    const currentLang =
      localStorage.getItem("preferred_lang") === "en" ? "es" : "en";
    updateLanguage(currentLang);
  });
</script>
