---
import Section from "../ui/Section.astro";
import SkillBadge from "../uiCustom/SkillBadge.astro";

import SeactionHeader from "../ui/SeactionHeader.astro";

import { SKILLS_DATA } from "../../data";

const TABS = [
  { id: "languages", label: "Languages" },
  { id: "frontend", label: "Frontend" },
  { id: "backend", label: "Backend" },
  { id: "database", label: "Database" },
  { id: "tools", label: "Tools" },
] as const;
---

<Section id="skills">
  <div class="flex flex-col gap-8 bg-violet-500/0">
    <!-- Context -->
    <div class="flex flex-col gap-2 text-center">
      <SeactionHeader titleKey="skill.title" subtitleKey="skill.description" />
    </div>

    <!-- TABS -->
    <div class="border-b border-brand-muted/15 overflow-x-auto no-scrollbar">
      <div
        class="flex items-center gap-2 sm:gap-4 w-max mx-auto font-mono text-xs sm:text-sm pb-2"
      >
        {
          TABS.map((tab, index) => (
            <>
              <button
                class:list={[
                  "tab-btn shrink-0 whitespace-nowrap cursor-pointer transition-colors py-1 px-2",
                  index === 0
                    ? "text-brand-accent font-semibold"
                    : "text-brand-muted hover:text-brand-text",
                ]}
                data-tab={tab.id}
              >
                {tab.label}
              </button>
              {index < TABS.length - 1 && (
                <span class="text-brand-muted/30 select-none">|</span>
              )}
            </>
          ))
        }
      </div>
    </div>

    <div class="grid">
      {
        TABS.map((tab, index) => (
          <div
            id={`content-${tab.id}`}
            class:list={[
              "skill-content col-start-1 row-start-1 flex flex-wrap content-start justify-center justify-self-center gap-4 max-w-6xl w-full transition-all duration-300",
              index !== 0 && "invisible opacity-0",
            ]}
          >
            {SKILLS_DATA[tab.id].map((skill) => (
              <div class="flex justify-center w-full sm:w-[calc((100%-1rem)/2)] md:w-[calc((100%-2rem)/3)] *:w-full *:max-w-md cursor-pointer select-none">
                <SkillBadge name={skill.name} level={skill.level}>
                  <skill.icon slot="icon" class="w-4 h-4 text-brand-text" />
                </SkillBadge>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</Section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  const contents = document.querySelectorAll<HTMLDivElement>(".skill-content");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = tab.getAttribute("data-tab");
      if (!target) return;

      tab.scrollIntoView({
        behavior: "smooth",
        inline: "center",
        block: "nearest",
      });

      tabs.forEach((t) => {
        const isActive = t === tab;
        t.classList.toggle("text-brand-accent", isActive);
        t.classList.toggle("font-semibold", isActive);
        t.classList.toggle("text-brand-muted", !isActive);
      });

      contents.forEach((content) => {
        const isActive = content.id === `content-${target}`;
        content.classList.toggle("invisible", !isActive);
        content.classList.toggle("opacity-0", !isActive);
      });
    });
  });
</script>
