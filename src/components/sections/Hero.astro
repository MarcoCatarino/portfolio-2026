---
import Section from "../ui/Section.astro";

import TechMarquee from "./TechMarquee.astro";

import { translations, defaultLang } from "../../i18n";
const lang = defaultLang;
---

<Section
  id="top"
  class="flex flex-col justify-between py-4 md:py-8 bg-green-600/0"
>
  <div class="my-auto w-full">
    <div class="grid grid-cols-1 md:grid-cols-10 items-center w-full gap-8">
      <!-- Content -->
      <div class="md:col-span-7 flex flex-col items-start gap-6">
        <span
          data-i18n="hero.greeting"
          class="text-brand-accent text-sm font-semibold tracking-wide"
        >
          {translations[lang]["hero.greeting"]}
        </span>

        <h1
          data-i18n="hero.role"
          class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-text tracking-tight leading-[1.15] max-w-2xl"
        >
          {translations[lang]["hero.role"]}
        </h1>

        <p
          data-i18n="hero.description"
          class="text-base sm:text-lg text-brand-muted max-w-2xl leading-relaxed min-h-18"
        >
          {translations[lang]["hero.description"]}
        </p>

        <a
          href="#contact"
          data-i18n="hero.cta"
          class="px-6 py-3 rounded-lg bg-brand-accent text-brand-bg font-bold hover:opacity-90 transition-opacity cursor-pointer shadow-sm"
        >
          {translations[lang]["hero.cta"]}
        </a>
      </div>

      <!-- Image -->
      <div class="md:col-span-3 flex justify-center items-center">
        <div
          class="relative w-full max-w-xs aspect-square rounded-2xl border-2 border-dashed border-brand-muted/50 bg-brand-muted/5 flex flex-col items-center justify-center text-center group overflow-hidden"
        >
          <img
            src="/images/myself.webp"
            alt="Placeholder Marco"
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>

  <div
    class="w-full mt-8 border-t border-dotted border-brand-muted/40 bg-red-800/0"
  >
    <TechMarquee />
  </div>
</Section>
