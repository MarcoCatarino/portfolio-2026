---
import SkillBadge from "../uiCustom/SkillBadge.astro";

import { SKILLS_DATA } from "../../data";

const allSkills = Object.values(SKILLS_DATA).flat();
const marqueeItems = [...allSkills, ...allSkills];
---

<div class="py-6 w-full overflow-hidden">
  <div
    class=`relative max-w-7xl mx-auto overflow-hidden mask-[linear-gradient(90deg, transparent, #000_10%, #000_90%, transparent)]`
  >
    <div class="animate-marquee flex gap-4 items-center py-2">
      {
        marqueeItems.map((skill) => (
          <div class="shrink-0 cursor-pointer select-none">
            <SkillBadge name={skill.name} showLevel={false}>
              <skill.icon slot="icon" class="w-4 h-4 text-brand-text" />
            </SkillBadge>
          </div>
        ))
      }
    </div>
  </div>
</div>
