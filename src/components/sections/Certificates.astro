---
import Section from "../ui/Section.astro";
import Carousel from "../ui/Carousel.astro";
import SeactionHeader from "../ui/SeactionHeader.astro";

import CertificateCard from "../uiCustom/CertificateCard.astro";
import CertificateModal from "../uiCustom/CertificateModal.astro";

import { CERTIFICATES_DATA } from "../../data";
import { getT } from "../../i18n";

const t = getT();
---

<Section id="certificates">
  <div class="flex flex-col gap-8">
    <div class="flex flex-col gap-2 text-center md:text-left">
      <SeactionHeader titleKey="cert.title" subtitleKey="cert.subtitle" />
    </div>

    <Carousel
      id="certificates-carousel"
      scrollAmount={320}
      autoPlayInterval={1500}
    >
      {
        CERTIFICATES_DATA.map((cert) => (
          <div class="snap-start shrink-0 w-72 sm:w-80">
            <CertificateCard
              id={cert.id}
              image={cert.image}
              title={t(`cert.${cert.id}.title`, cert.id)}
            />
          </div>
        ))
      }
    </Carousel>
  </div>

  <CertificateModal />
</Section>
