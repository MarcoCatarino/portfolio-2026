---
interface Props {
  id: string;
  class?: string;
}

const { id, class: className = "" } = Astro.props;
---

<section
  id={id}
  class:list={[
    "py-4 md:py-8 w-full flex flex-col justify-center font-mono scroll-mt-16 bg-red-300 md:bg-amber-200 lg:bg-fuchsia-200 xl:bg-violet-400",
    className,
  ]}
>
  <div class="max-w-7xl mx-auto px-4 w-full">
    <slot />
  </div>
</section>
