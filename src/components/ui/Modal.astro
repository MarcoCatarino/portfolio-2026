---
import CrossMark from "../../assets/icons/ui/crossMark.svg";

interface Props {
  id: string;
  size?: "md" | "lg" | "xl";
}

const { id, size = "md" } = Astro.props;

const sizes = {
  md: "max-w-lg",
  lg: "max-w-2xl",
  xl: "max-w-4xl",
} as const;
---

<dialog
  id={id}
  class:list={[
    "backdrop:bg-brand-text/60 backdrop:backdrop-blur-xs p-0 rounded-2xl bg-brand-surface border border-brand-muted/20 w-[90%] max-h-[90vh] overflow-y-auto shadow-2xl font-mono text-brand-text transition-all m-auto focus:outline-none",
    sizes[size],
  ]}
>
  <div class="p-6 flex flex-col gap-6">
    <button
      type="button"
      class="modal-close-btn absolute top-3 right-3 z-20 w-9 h-9 flex items-center justify-center rounded-full bg-brand-surface/80 backdrop-blur-sm border border-brand-muted/20 text-brand-text hover:bg-brand-muted/10 transition-colors cursor-pointer"
      aria-label="Cerrar modal"
    >
      <CrossMark class="w-4 h-4" />
    </button>

    <slot name="media" />

    <div class="flex items-start justify-between gap-4">
      <slot name="header" />
    </div>

    <slot name="content" />
  </div>
</dialog>

<script define:vars={{ id }}>
  const modalElement = document.getElementById(id);
  const closeBtn = modalElement?.querySelector(".modal-close-btn");

  if (modalElement && closeBtn) {
    closeBtn.addEventListener("click", () => {
      modalElement.close();
      document.activeElement?.blur();
    });

    modalElement.addEventListener("click", (e) => {
      const rect = modalElement.getBoundingClientRect();
      const isInDialog =
        rect.top <= e.clientY &&
        e.clientY <= rect.bottom &&
        rect.left <= e.clientX &&
        e.clientX <= rect.right;
      if (!isInDialog) {
        modalElement.close();
        document.activeElement?.blur();
      }
    });
  }
</script>
