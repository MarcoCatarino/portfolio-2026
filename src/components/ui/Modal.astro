---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<dialog
  id={id}
  class="backdrop:bg-brand-text/50 backdrop:backdrop-blur-xs p-0 rounded-2xl bg-brand-surface border border-brand-muted/20 max-w-lg w-[90%] shadow-2xl font-mono text-brand-text transition-all m-auto focus:outline-none"
>
  <div class="p-6 flex flex-col gap-6">
    <div class="flex items-start justify-between gap-4">
      <slot name="header" />
      <button
        type="button"
        class="modal-close-btn text-brand-muted hover:text-brand-text text-lg font-bold px-2 py-0.5 rounded-lg hover:bg-brand-muted/10 transition-colors cursor-pointer"
        aria-label="Cerrar modal"
      >
        ✕
      </button>
    </div>

    <slot name="content" />
  </div>
</dialog>

<script define:vars={{ id }}>
  const modalElement = document.getElementById(id);
  const closeBtn = modalElement?.querySelector(".modal-close-btn");

  if (modalElement && closeBtn) {
    closeBtn.addEventListener("click", () => {
      modalElement.close();
      document.activeElement?.blur();
    });

    modalElement.addEventListener("click", (e) => {
      const rect = modalElement.getBoundingClientRect();
      const isInDialog =
        rect.top <= e.clientY &&
        e.clientY <= rect.bottom &&
        rect.left <= e.clientX &&
        e.clientX <= rect.right;
      if (!isInDialog) {
        modalElement.close();
        document.activeElement?.blur();
      }
    });
  }
</script>
